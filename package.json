{
  "name": "krexa-agent-ledger",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm run test:rust && pnpm run test:sandbox && pnpm run test:ts",
    "test:rust": "cargo test -p ual",
    "test:ts": "pnpm -r --if-present test",
    "test:sandbox": "pnpm run build:contract && cargo test -p integration",
    "demo": "bash scripts/demo.sh",
    "web": "pnpm -F @krexa-ual/web start",
    "ebi:report": "pnpm -F @krexa-ual/experiments-ebi report",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "secrets": "gitleaks detect --no-banner --redact",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:contract": "cargo near build non-reproducible-wasm --manifest-path contracts/ual/Cargo.toml",
    "archive:once": "pnpm -F @krexa-ual/archive once",
    "archive:loop": "pnpm -F @krexa-ual/archive loop",
    "archive:verify": "pnpm -F @krexa-ual/archive verify",
    "archive:stats": "pnpm -F @krexa-ual/archive stats",
    "fetcher:keygen": "pnpm -F @krexa-ual/fetcher keygen",
    "fetcher:once": "pnpm -F @krexa-ual/fetcher once",
    "fetcher:from-archive": "pnpm -F @krexa-ual/fetcher from-archive",
    "verifier:codehash": "pnpm -F @krexa-ual/verifier codehash",
    "runtime:sim": "pnpm run build:contract && bash scripts/with-sandbox.sh pnpm -F @krexa-ual/runtime sim",
    "ual": "pnpm -F @krexa-ual/runtime exec tsx src/main.ts",
    "testnet:walkthrough": "pnpm -F @krexa-ual/runtime exec tsx ../../scripts/testnet-walkthrough.ts",
    "mcp": "pnpm -F @krexa-ual/mcp start",
    "attack-demo": "pnpm run build:contract >/dev/null && bash scripts/with-sandbox.sh pnpm -F @krexa-ual/runtime exec tsx ../../scripts/attack-demo.ts",
    "allocator-csv": "pnpm -F @krexa-ual/experiments-ebi allocator-csv",
    "submit": "pnpm -F @krexa-ual/runtime exec tsx ../../scripts/submit.ts"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.21"
    }
  }
}
