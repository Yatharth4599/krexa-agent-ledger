# Copy to .env and fill in. .env is gitignored. Never commit real values.

# ---- Safety gates ----
# Live execution is OFF unless this is exactly 1 AND the operator types "yes" at the terminal.
# Leave empty or 0 for every normal run, including everything a judge runs.
UAL_ALLOW_LIVE=0

# ---- NEAR ----
# Network for the SDK and runtime: sandbox | testnet
UAL_NETWORK=sandbox
# Deployed contract account (filled in after scripts/deploy-testnet.sh)
UAL_CONTRACT_ID=ual.krexa-ual.testnet
# Owner / desk account on testnet. Full-access key lives in ~/.near-credentials, never here.
UAL_OWNER_ACCOUNT=krexa-ual.testnet

# ---- LLM (optional; sim mode needs no keys) ----
# NEAR AI Cloud, OpenAI-compatible endpoint. Preferred so aiSigHash can be real.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Hard daily spend cap in USD for the agent runtime. Runtime refuses to start without it.
LLM_DAILY_BUDGET_USD=5

# ---- NEAR Intents 1Click (optional; dry quotes only by default) ----
# Without a JWT there is an extra fee per 1Click docs. Dry quotes do not move funds.
ONECLICK_JWT=

# ---- Evidence fetcher ----
# ed25519 secret key (base58) for the local unattested fetcher build.
# Generated by `pnpm fetcher:keygen`. Receipts from this key are labelled fetcher: unattested.
FETCHER_SECRET_KEY=
